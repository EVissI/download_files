# Домены подставляются из APP_DOMAIN / APP_DOMAIN_OLD при старте контейнера
# (официальный entrypoint nginx + NGINX_ENVSUBST_FILTER=^APP_, поэтому
# переменные самого nginx вида $host / $scheme не трогаются).
#
# Общие настройки проксирования — в snippets/app.conf, TLS — в snippets/ssl.conf.

upstream app {
    server fastapi:8000;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Запрос с чужим Host (сканеры по IP) — рвём соединение.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

# HTTP: только ACME-проверка, остальное на HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name ${APP_DOMAIN} www.${APP_DOMAIN} ${APP_DOMAIN_OLD};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# www → на основной домен без www.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;

    return 301 https://${APP_DOMAIN}$request_uri;
}

# Основной домен.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;

    include /etc/nginx/snippets/app.conf;
}

# Прежний домен. Сейчас отдаёт то же самое, чтобы старые ссылки и кнопки
# в Telegram продолжали работать во время переезда.
#
# ФАЗА 2 (когда learnbg.ru проверен и MINI_APP_URL уже на него):
#   закомментировать include ниже и раскомментировать return 301.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${APP_DOMAIN_OLD};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN_OLD}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN_OLD}/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;

    include /etc/nginx/snippets/app.conf;
    # return 301 https://${APP_DOMAIN}$request_uri;
}
