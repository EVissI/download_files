# Конфиг сайта. Домен подставляется из APP_DOMAIN при старте контейнера
# (официальный entrypoint nginx + NGINX_ENVSUBST_FILTER=^APP_, поэтому
# переменные самого nginx вида $host / $scheme не трогаются).

upstream app {
    server fastapi:8000;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Запрос с чужим Host (сканеры по IP) — рвём соединение.
# Раньше на его месте отдавался /var/www/html.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

# HTTP: только ACME-проверка, остальное на HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name ${APP_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;

    # Аналог options-ssl-nginx.conf от certbot, но без зависимости от его файлов:
    # nginx должен стартовать, даже если certbot ещё ничего не положил рядом.
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    server_tokens off;

    # Лимиты приложения: карточки и веб-загрузки — 30 МБ (запас на multipart).
    # Исключение — импорт архива аудио, см. отдельный location ниже.
    client_max_body_size 40m;

    # Анализ .mat и выгрузки бывают долгими.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # Общие заголовки прокси. ВАЖНО: если в location появится свой
    # proxy_set_header, эти перестанут наследоваться — их надо продублировать
    # (так сделано в /admin).
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # /web — публичный лендинг (bot/routers/web_landing_router.py).
    location = / {
        return 301 /web;
    }

    location /static/ {
        proxy_pass http://app;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /admin/static/ {
        proxy_pass http://app;
        expires 7d;
        add_header Cache-Control "public";
    }

    # Flask-AppBuilder смонтирован на /admin и ждёт X-Script-Name.
    location /admin {
        proxy_pass http://app;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Script-Name     /admin;
    }

    # Импорт mp3-архива в «Анализ матча»: приложение принимает до 200 МБ.
    location = /api/match_analysis/audio/import_mp3_zip {
        proxy_pass http://app;
        client_max_body_size 220m;
        proxy_request_buffering off;
    }

    # Всё остальное отдаёт FastAPI: /web, /hint-viewer, /pokaz, /cards-cabinet,
    # /pip-count-cabinet, /content-card-view, /board-viewer,
    # /match-analysis-cabinet, /match-analysis-view, /api/...
    # Перечислять их поштучно не нужно — приложение само отвечает 404/444
    # на мусорные пути (SecurityHeadersMiddleware).
    location / {
        proxy_pass http://app;
    }
}
