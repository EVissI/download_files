
# Получите от @BotFather в Telegram: https://t.me/botfather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# ID чата/группы для уведомлений
CHAT_GROUP_ID=1234567890

# List ID администраторов бота (через запятую)
ROOT_ADMIN_IDS=[123456789, 987654321]

# URL мини-приложения Telegram
MINI_APP_URL=https://your-domain.com/miniapp

# Включать попытку fullscreen для Telegram WebApp (Bot API 8.0+)
WEBAPP_FULLSCREEN_ENABLED=true

# Яндекс диск API токен 
YA_API_TOKEN=your_yandex_api_token_here

# ЮKassa (Яндекс.Касса) API ключ для обработки платежей
YO_KASSA_TEL_API_KEY=your_yokassa_api_key_here

# S3 (Timeweb и др.) — hint viewer
S3_URL=https://s3.example.com
BACKET_NAME=your-bucket
S3_ACCESS_KEY=
S3_SECRET_ACESS_KEY=
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path

# API ключ для доступа к Syncthing серверу (если используется file_router и т.п.)
SYNCTHING_API_KEY=your_syncthing_api_key_here

# Host и порт Syncthing (формат: host:port)
SYNCTHING_HOST=localhost:8384

# Папка в Syncthing для синхронизации файлов
SYNCTHING_FOLDER=backgammon-files


POSTGRES_USER=backgammon
POSTGRES_PASSWORD=super_secure_postgres_password_change_me
POSTGRES_DB=backgammon

REDIS_USER=default
REDIS_PASSWORD=super_secure_redis_password_change_me
REDIS_USER_PASSWORD=super_secure_redis_user_password_change_me
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ===== Redis между серверами (bot + worker) =====
# На главном сервере bot/api ходят в redis через docker-сеть (REDIS_HOST=redis).
# На worker-сервере укажите Tailscale IP главного сервера:
#   REMOTE_REDIS_HOST=100.x.x.x
# Узнать IP: tailscale ip -4  (на главном сервере)
# Redis не должен быть открыт в интернет — только через VPN (см. ufw ниже).
REMOTE_REDIS_HOST=100.x.x.x

SECRET_KEY=your-very-long-random-secret-key-change-in-production-min-32-chars

# Кол-во обработчиков для сервиса ошибок
WORKERS_COUNT=1

# Прокси Telegram — только через FAB → «Прокси Telegram» (таблица telegram_proxies в БД).
# Устаревший TELEGRAM_PROXY в .env/окружении больше не используется; строку можно удалить.

# ===== SMTP (email-уведомления админу) =====
# Адрес получателя задаётся в FAB → «Настройки WebApp» → «Email для уведомлений».
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Backgammon Bot
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Отдельная веб-версия просмотра ошибок (не Telegram): /web/hints
# Пользователей создают в FAB (Веб-пользователи). История привязана к аккаунту.
# Ключ для расшифровки пароля в карточке FAB. Пусто = используется SECRET_KEY.
WEB_USER_PASSWORD_KEY=

